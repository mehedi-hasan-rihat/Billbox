// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum BillStatus {
  INBOX  // Arrived via inbox, not yet confirmed
  UNPAID // Confirmed/created, payment not yet made
  PAID   // Payment completed
}

enum BillCategory {
  INTERNET
  ELECTRICITY
  GAS
  WATER
  MOBILE
  RESTAURANT
  SHOPPING
  SUBSCRIPTION
  RENT
  EDUCATION
  OTHER
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
  CARD
  OTHER
}

// How the bill entered BillBox
enum BillSource {
  MANUAL // User created it themselves (includes recurring-generated bills)
  INBOX  // Arrived via BillBox ID from another user
}

enum BillType {
  ONE_TIME  // A regular single bill
  RECURRING // Generated from a recurring rule
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  STOPPED
}

// Every meaningful thing that happens to a bill
enum BillEventType {
  CREATED    // Bill created manually
  SENT       // Bill sent to a BillBox ID
  RECEIVED   // Bill arrived in recipient's inbox
  CONFIRMED  // Inbox bill confirmed by recipient
  PAID       // Bill marked as paid
  EDITED     // Bill details edited
  NOTE_ADDED      // Note added or updated
  PAYMENT_UPDATED // Payment record updated
  RECURRING_GENERATED // Bill generated from a recurring rule
}

// ── Models ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  billBoxId String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills         Bill[]     @relation("OwnerBills")
  receivedBills Bill[]     @relation("ReceiverBills")
  sentBills     Bill[]     @relation("SenderBills")
  billers       Biller[]
  billEvents    BillEvent[]
  recurringRules RecurringRule[]

  @@map("users")
}

// A biller is a sender/provider in the user's personal list.
// Can be a BillBox user (billBoxId set) or an external party.
model Biller {
  id        String  @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])

  name      String
  phone     String?
  email     String?
  address   String?

  // Set if this biller is a BillBox user — enables direct inbox sending
  billBoxId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills     Bill[]

  @@index([userId])
  @@index([userId, billBoxId])
  @@map("billers")
}

model Bill {
  id     String @id @default(cuid())

  // Ownership
  userId String
  user   User   @relation("OwnerBills", fields: [userId], references: [id])

  // Origin
  source BillSource @default(MANUAL)
  type   BillType   @default(ONE_TIME)

  // Core info
  name     String
  category BillCategory
  amount   Decimal      @db.Decimal(12, 2)
  billDate DateTime?
  dueDate  DateTime?
  note     String?

  // Sender biller (optional — who issued/sent the bill)
  senderBillerId  String?
  senderBiller    Biller? @relation(fields: [senderBillerId], references: [id])

  // Payment state
  status BillStatus @default(UNPAID)

  // Inbox-specific (null for manually created bills)
  confirmedStatus BillStatus?
  receiverId      String?
  receiver        User?       @relation("ReceiverBills", fields: [receiverId], references: [id])
  senderId        String?
  senderUser      User?       @relation("SenderBills", fields: [senderId], references: [id])
  sentAt          DateTime?   // when sender sent it
  receivedAt      DateTime?   // when it landed in recipient's inbox
  confirmedAt     DateTime?   // when recipient confirmed it

  // Payment record
  paidAt           DateTime?
  paidAmount       Decimal?       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?
  paymentReference String?

  // Recurring rule link (null for one-off bills)
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments BillAttachment[]
  events      BillEvent[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, category])
  @@index([userId, source])
  @@index([userId, type])
  @@index([userId, billDate])
  @@index([userId, amount])
  @@map("bills")
}

// A recurring rule is a template for generating bills automatically.
// Generated bills link back to this rule via recurringRuleId.
model RecurringRule {
  id     String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Template fields — copied into each generated bill
  name           String
  category       BillCategory
  amount         Decimal      @db.Decimal(12, 2)
  note           String?
  senderBillerId String?

  // Recurrence schedule
  frequency          RecurringFrequency
  // For MONTHLY: day of month (1–28). For WEEKLY: day of week (0=Sun–6=Sat). For YEARLY: stored as MM-DD string.
  dayRule            String

  // How many days before the due date to generate the bill
  generateDaysBefore Int @default(5)

  status         RecurringStatus @default(ACTIVE)

  // Scheduler state — next time a bill should be generated
  nextGenerateAt DateTime

  // When recurrence ends (null = runs forever)
  endsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedBills Bill[]

  @@index([status, nextGenerateAt])
  @@index([userId])
  @@map("recurring_rules")
}

// Full audit trail for a bill — one row per event
model BillEvent {
  id      String        @id @default(cuid())
  billId  String
  bill    Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)

  type    BillEventType

  // Who triggered it (null for system-generated events)
  actorId String?
  actor   User?         @relation(fields: [actorId], references: [id])

  // Extra context — e.g. { from: 'INBOX', to: 'UNPAID' } or { field: 'amount', old: '1000', new: '1200' }
  metadata Json?

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([billId, type])
  @@map("bill_events")
}

model BillAttachment {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String
  fileSize  Int
  url       String
  createdAt DateTime @default(now())

  @@map("bill_attachments")
}
