// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum BillStatus {
  INBOX           // Arrived via inbox, not yet confirmed
  UNPAID          // Confirmed/created, no payments yet
  PARTIALLY_PAID  // At least one payment made, balance remains
  PAID            // Fully paid
}

enum BillCategory {
  INTERNET
  ELECTRICITY
  GAS
  WATER
  MOBILE
  RESTAURANT
  SHOPPING
  SUBSCRIPTION
  RENT
  EDUCATION
  OTHER
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK
  CARD
  OTHER
}

// How the bill entered BillBox
enum BillSource {
  MANUAL // User created it themselves (includes recurring-generated bills)
  INBOX  // Arrived via BillBox ID from another user
}

enum BillType {
  ONE_TIME  // A regular single bill
  RECURRING // Generated from a recurring rule
}

enum BillDirection {
  OUTGOING  // You owe money — an expense / debit
  INCOMING  // You are owed money — income / credit
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  STOPPED
}

// Every meaningful thing that happens to a bill
enum BillEventType {
  CREATED    // Bill created manually
  SENT       // Bill sent to a BillBox ID
  RECEIVED   // Bill arrived in recipient's inbox
  CONFIRMED  // Inbox bill confirmed by recipient
  PAYMENT_ADDED   // A payment installment recorded
  PAYMENT_UPDATED // A payment installment updated
  PAYMENT_DELETED // A payment installment removed
  FULLY_PAID      // Bill reached fully paid state
  EDITED     // Bill details edited
  NOTE_ADDED      // Note added
  NOTE_UPDATED    // Note updated
  NOTE_DELETED    // Note deleted
  RECURRING_GENERATED // Bill generated from a recurring rule
}

// ── Models ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  billBoxId String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills         Bill[]     @relation("OwnerBills")
  receivedBills Bill[]     @relation("ReceiverBills")
  sentBills     Bill[]     @relation("SenderBills")
  contacts      Contact[]
  billEvents    BillEvent[]
  recurringRules RecurringRule[]

  @@map("users")
}

// A contact is a party in the user's personal list.
// Can be a BillBox user (billBoxId set) or an external party.
// direction: OUTGOING = party who bills you (expense); INCOMING = party you bill (income).
model Contact {
  id        String  @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])

  name      String
  phone     String?
  email     String?
  address   String?

  // Set if this contact is a BillBox user — enables direct inbox sending
  billBoxId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills     Bill[]

  @@index([userId])
  @@index([userId, billBoxId])
  @@map("contacts")
}

model Bill {
  id     String @id @default(cuid())

  // Ownership
  userId String
  user   User   @relation("OwnerBills", fields: [userId], references: [id])

  // Origin
  source    BillSource    @default(MANUAL)
  type      BillType      @default(ONE_TIME)
  direction BillDirection @default(OUTGOING)

  // Core info
  name      String
  category  BillCategory
  amount    Decimal      @db.Decimal(12, 2)
  issueDate DateTime?    // date printed on the bill (formerly billDate)
  dueDate   DateTime?
  notes     String[]

  // Contact (optional — who issued/sent the bill)
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])

  // Payment state
  status BillStatus @default(UNPAID)

  // Inbox-specific (null for manually created bills)
  confirmedStatus BillStatus?
  receiverId      String?
  receiver        User?       @relation("ReceiverBills", fields: [receiverId], references: [id])
  senderId        String?
  senderUser      User?       @relation("SenderBills", fields: [senderId], references: [id])
  confirmedAt     DateTime?   // when recipient confirmed it


  // Recurring rule link (null for one-off bills)
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments BillAttachment[]
  events      BillEvent[]
  payments    BillPayment[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, category])
  @@index([userId, source])
  @@index([userId, type])
  @@index([userId, issueDate])
  @@index([userId, amount])
  @@map("bills")
}

// A recurring rule is a template for generating bills automatically.
// Generated bills link back to this rule via recurringRuleId.
model RecurringRule {
  id     String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Template fields — copied into each generated bill
  name           String
  category       BillCategory
  amount         Decimal      @db.Decimal(12, 2)
  note           String?
  contactId      String?

  // Recurrence schedule
  frequency          RecurringFrequency
  // For MONTHLY: day of month (1–28). For WEEKLY: day of week (0=Sun–6=Sat). For YEARLY: stored as MM-DD string.
  dayRule            String

  // How many days before the due date to generate the bill
  generateDaysBefore Int @default(5)

  status         RecurringStatus @default(ACTIVE)

  // Scheduler state — next time a bill should be generated
  nextGenerateAt DateTime

  // When recurrence ends (null = runs forever)
  endsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedBills Bill[]

  @@index([status, nextGenerateAt])
  @@index([userId])
  @@map("recurring_rules")
}

// Full audit trail for a bill — one row per event
model BillEvent {
  id      String        @id @default(cuid())
  billId  String
  bill    Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)

  type    BillEventType

  // Who triggered it (null for system-generated events)
  actorId String?
  actor   User?         @relation(fields: [actorId], references: [id])

  // Extra context — e.g. { from: 'INBOX', to: 'UNPAID' } or { field: 'amount', old: '1000', new: '1200' }
  metadata Json?

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([billId, type])
  @@map("bill_events")
}

model BillPayment {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount          Decimal       @db.Decimal(12, 2)
  paidOn          DateTime      // when this payment was made
  paymentMethod   PaymentMethod?
  paymentReference String?
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billId])
  @@map("bill_payments")
}

model BillAttachment {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  fileName  String
  fileType  String
  fileSize  Int
  url       String
  createdAt DateTime @default(now())

  @@map("bill_attachments")
}
